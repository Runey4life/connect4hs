cabal-version:      3.0
name:               connect4-web
version:            0.1.0.0
synopsis:           Connect 4 game served over WebSockets
license:            MIT
author:             You
build-type:         Simple

executable connect4-web
    main-is:          Main.hs
    hs-source-dirs:   src
    build-depends:
        base          >= 4.14 && < 5,
        websockets    >= 0.12,
        wai           >= 3.2,
        warp          >= 3.3,
        wai-websockets >= 3.0,
        wai-app-static >= 3.1,
        scotty        >= 0.12,
        aeson         >= 2.0,
        text          >= 1.2,
        bytestring    >= 0.10,
        stm           >= 2.5
    default-language: Haskell2010
    ghc-options:      -O2 -Wall
